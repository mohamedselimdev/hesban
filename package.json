{
  "name": "hesban",
  "version": "0.0.0",
  "private": true,
  "description": "HESBAN offline Arabic POS for Egyptian retail",
  "author": "Mohamed Selim",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/electron/**",
    "test:electron": "electron-vite build && vitest run tests/electron/runtime.test.ts",
    "test:ui": "vitest run tests/electron/ui.test.ts",
    "verify:build": "node tools/verify-build.mjs",
    "scan:secrets": "node tools/scan-secrets.ts",
    "docs:links": "node tools/check-doc-links.ts",
    "audit:ci": "pnpm audit --prod && pnpm audit --audit-level high && pnpm audit signatures",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --lockfile-only --out sbom.cdx.json",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
